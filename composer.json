{
  "name": "homlity/sdk-ciencuadras",
  "description": "SDK PHP para integracion con la API de Ciencuadras (Integradores)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Ciencuadras\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ciencuadras\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  }
}
